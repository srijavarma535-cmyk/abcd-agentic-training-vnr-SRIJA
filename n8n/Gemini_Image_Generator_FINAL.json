    {
      "parameters": {
        "jsCode": "// Generate 3 variation prompts for each row\nconst items = [];\nconst basePrompt = $input.item.json.prompt;\nconst rowNumber = $input.item.json.row_number;\nconst variations = 3;\n\nfor (let i = 0; i < variations; i++) {\n  items.push({\n    json: {\n      prompt: basePrompt,\n      variation_index: i,\n      row_number: rowNumber,\n      enhanced_prompt: basePrompt + ` ultra realistic, 4k, detailed, cinematic lighting, variation ${i + 1}`,\n      seed: (parseInt(rowNumber || 0) * 100) + i\n    }\n  });\n}\n\nreturn items;"
      },
      "id": "generate-variations",
      "name": "Generate 3 Variations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [240, 200]
    },

    {
      "parameters": {
        "url": "=https://image.pollinations.ai/prompt/{{ encodeURIComponent($json[\"enhanced_prompt\"]) }}?width=1024&height=1024&seed={{ $json[\"seed\"] }}&nologo=true&enhance=true",
        "options": {
          "timeout": 60000,
          "retry": {
            "enabled": true,
            "maxTries": 3,
            "waitBetweenTries": 5000
          },
          "response": {
            "response": {
              "responseFormat": "file"
            }
          }
        }
