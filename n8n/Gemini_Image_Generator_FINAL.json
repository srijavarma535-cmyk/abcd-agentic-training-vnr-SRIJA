    {
      "parameters": {
        "jsCode": "// Build all image URLs and hyperlink formulas for this item\nconst fileId = $input.item.json.id;\nconst prompt = $input.item.json.name ? \n  $input.item.json.name.replace(/_var[0-9]+.*/,'').replace('generated_','').replace(/_/g,' ') : '';\n\nconst directUrl = `https://drive.google.com/file/d/${fileId}/view`;\nconst embedUrl = `https://drive.google.com/uc?id=${fileId}`;\nconst hyperlink = `=HYPERLINK(\"https://drive.google.com/file/d/${fileId}/view\",\"View Image ${$input.item.json.variation_index !== undefined ? '#' + ($input.item.json.variation_index + 1) : ''}\")  `;\n\nreturn [{\n  json: {\n    ...($input.item.json),\n    file_id: fileId,\n    direct_url: directUrl,\n    embed_url: embedUrl,\n    hyperlink_formula: hyperlink,\n    created_at: new Date().toISOString()\n  }\n}];"
      },
      "id": "build-urls",
      "name": "Build URLs & Hyperlink",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [1440, 120]
    },

    {
      "parameters": {
        "jsCode": "// Aggregate all 3 variation URLs for the same prompt into one row update\n// This node collects items and groups by original prompt\nconst item = $input.item.json;\n\n// We store variation URLs individually — sheet uses comma-separated list\nreturn [{\n  json: {\n    prompt: item.prompt || '',\n    row_number: item.row_number || '',\n    image_url: item.direct_url,\n    embed_url: item.embed_url,\n    hyperlink_formula: item.hyperlink_formula,\n    file_id: item.file_id,\n    variation_index: item.variation_index,\n    created_at: item.created_at\n  }\n}];"
      },
