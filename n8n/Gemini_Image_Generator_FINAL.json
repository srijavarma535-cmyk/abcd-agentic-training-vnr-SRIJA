    {
      "parameters": {
        "jsCode": "// Dashboard summary node - runs after all items processed\n// Counts pending, success, failed rows\nconst items = $input.all();\nlet success = 0, failed = 0, pending = 0;\n\nitems.forEach(item => {\n  const status = (item.json.Status || '').toLowerCase();\n  if (status === 'success') success++;\n  else if (status === 'failed') failed++;\n  else pending++;\n});\n\nreturn [{\n  json: {\n    total: items.length,\n    success,\n    failed,\n    pending,\n    summary: `✅ ${success} success | ❌ ${failed} failed | ⏳ ${pending} pending`,\n    timestamp: new Date().toISOString()\n  }\n}];"
      },
      "id": "dashboard-summary",
      "name": "Dashboard Summary",
      "type": "n8n-nodes-base.code",
